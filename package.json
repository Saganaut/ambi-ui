{
  "name": "@saganaut/ambi-ui",
  "version": "0.0.0",
  "description": "React component library for Ambi applications",
  "homepage": "https://github.com/Saganaut/ambi-ui#readme",
  "bugs": {
    "url": "https://github.com/Saganaut/ambi-ui/issues"
  },
  "license": "MIT",
  "author": "Saganaut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saganaut/ambi-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "prepublishOnly": "vp run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm check && vp test --run && vp pack && changeset publish"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "lucide-react": "^1.31.0",
    "morphicons": "^1.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^11.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.5.7",
    "stylelint": "^17.10.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-order": "^8.1.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
